{
  "name": "pdfburrow",
  "version": "1.0.0",
  "private": true,
  "description": "Free PDF tools that run in your browser. Files are never uploaded.",
  "author": "Yousaf K Hamza",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "build": "node build.mjs",
    "check": "node scripts/check.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "ci": "npm test && npm run build && npm run check"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "heic2any": "0.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.49.1"
  }
}
